# Copiez ce fichier en .env puis adaptez les valeurs.

# Port d'accès à l'application
APP_PORT=8080

# Secret de signature des sessions (32+ caractères aléatoires, OBLIGATOIRE)
# Générer : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=remplacez-moi-par-une-longue-chaine-aleatoire

# Base PostgreSQL
POSTGRES_USER=pokerorga
POSTGRES_PASSWORD=pokerorga
POSTGRES_DB=pokerorga

# true si l'application est servie en HTTPS (cookie Secure)
COOKIE_SECURE=false

# false pour fermer les inscriptions de nouveaux organisateurs
ALLOW_REGISTRATION=true

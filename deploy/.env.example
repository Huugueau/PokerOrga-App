# Copiez ce fichier en .env (dans le même dossier que docker-compose.yml) puis adaptez.

# Port local sur lequel Nginx joint l'application (changer si 8080 est déjà pris sur le VPS)
APP_PORT=8080

# Secret de signature des sessions — OBLIGATOIRE, 64 caractères aléatoires :
#   openssl rand -hex 32
JWT_SECRET=

# Base PostgreSQL — mot de passe OBLIGATOIRE :
#   openssl rand -hex 16
POSTGRES_USER=pokerorga
POSTGRES_PASSWORD=
POSTGRES_DB=pokerorga

# Passez à false une fois vos comptes organisateurs créés
ALLOW_REGISTRATION=true

# Image à déployer (par défaut la dernière version de main). Pour figer une version :
#   IMAGE=ghcr.io/huugueau/pokerorga-app:sha-<7 caractères du commit>
# IMAGE=ghcr.io/huugueau/pokerorga-app:latest
